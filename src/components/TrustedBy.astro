---
// Neutral geometric marks rather than company logos. Naming an employer is
// referential use; reproducing their logo is not, and Microsoft's brand
// guidelines require an express licence for theirs.
const roles = [
  { company: "Roland Berger", role: "DevSecOps Engineer", color: "secondary", icon: "layers" },
  { company: "Microsoft", role: "Support Escalation Engineer", color: "primary", icon: "hex" },
  { company: "Orange", role: "Operational Specialist", color: "on-surface", icon: "ring" }
];
---

<section class="py-16 border-t" style="background-color: var(--color-surface-container-low); border-color: rgba(65, 71, 84, 0.1)">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-2xl font-bold headline-font tracking-tighter uppercase mb-4">Where I've Worked</h2>
      <p class="max-w-xl mx-auto" style="color: var(--color-on-surface-variant)">
        Enterprise experience across consulting, tech, and telecom.
      </p>
    </div>
    <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16 w-full max-w-lg md:max-w-none">
      {roles.map(item => (
        <div class="flex items-center gap-3 w-full justify-start md:justify-center opacity-80 hover:opacity-100 transition-opacity">
          <div class="w-10 h-10 flex items-center justify-center shrink-0">
            <svg
              viewBox="0 0 24 24"
              width="30"
              height="30"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              style={`color: var(--color-${item.color})`}
            >
              {item.icon === "layers" && (
                <>
                  <path d="M12 3l9 4.8-9 4.8-9-4.8L12 3z" />
                  <path d="M3 12.2l9 4.8 9-4.8" />
                  <path d="M3 16.4l9 4.8 9-4.8" />
                </>
              )}
              {item.icon === "hex" && (
                <>
                  <path d="M12 2.6l8.2 4.7v9.4L12 21.4l-8.2-4.7V7.3L12 2.6z" />
                  <path d="M12 8.2l3.6 2.1v4.2L12 16.6l-3.6-2.1v-4.2L12 8.2z" />
                </>
              )}
              {item.icon === "ring" && (
                <>
                  <circle cx="12" cy="12" r="8.6" />
                  <circle cx="12" cy="12" r="3.2" />
                </>
              )}
            </svg>
          </div>
          <div class="text-left">
            <div class="text-lg font-bold" style={`color: var(--color-${item.color})`}>{item.company}</div>
            <div class="text-xs" style="color: var(--color-on-surface-variant)">{item.role}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
