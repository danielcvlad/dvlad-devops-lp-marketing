---
// Rendered at build time so it survives JS being off; corrected below if the
// deploy predates the visitor's current year.
const buildYear = new Date().getFullYear();
---

<footer class="border-t-0" style="background-color: var(--color-background)">
  <div class="py-6" style="background-color: var(--color-surface-container-low)">
    <div class="flex justify-center items-center w-full px-8 max-w-[1920px] mx-auto">
      <div class="font-mono text-[10px] uppercase tracking-widest" style="color: var(--color-outline-variant)">
        © <span id="footer-year">{buildYear}</span> Daniel Vlad
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    const el = document.getElementById('footer-year');
    const now = String(new Date().getFullYear());
    if (el && el.textContent !== now) el.textContent = now;
  })();
</script>
