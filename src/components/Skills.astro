---
import { resumeData } from '../data/resume';

// Editorial highlights. The exhaustive list lives in resumeData.skills.
const highlights = [
  {
    icon: "cloud",
    iconColor: "primary",
    tint: "rgba(34, 167, 0, 0.1)",
    title: "Multi-Cloud Strategy",
    detail: "Azure (Expert), AWS, GCP, DigitalOcean"
  },
  {
    icon: "security",
    iconColor: "primary",
    tint: "rgba(52, 229, 7, 0.1)",
    title: "Security & Identity",
    detail: "Zero Trust, Entra ID, PIM, Sentinel, Defender, MITRE ATT&CK"
  },
  {
    icon: "dns",
    iconColor: "secondary",
    tint: "rgba(68, 143, 255, 0.1)",
    title: "Orchestration & Tooling",
    detail: "Kubernetes, Docker, Helm, AKS, EKS, ACR, ECR, Nexus"
  },
  {
    icon: "code",
    iconColor: "primary",
    tint: "var(--color-surface-container-highest)",
    title: "Infrastructure as Code",
    detail: "Terraform, Bicep, ARM Templates, Ansible"
  },
  {
    icon: "sync",
    iconColor: "secondary",
    tint: "var(--color-surface-container-highest)",
    title: "CI/CD & Automation",
    detail: "Azure DevOps, Jenkins, GitHub Actions, GitLab CI, Python"
  },
  {
    icon: "monitoring",
    iconColor: "secondary",
    tint: "rgba(68, 143, 255, 0.1)",
    title: "Monitoring & Observability",
    detail: "Prometheus, Grafana, Azure Monitor, New Relic"
  }
];
---

<section class="py-24 max-w-6xl mx-auto px-6">
  <div class="grid lg:grid-cols-2 gap-12 items-start">
    <div class="text-center lg:text-left flex flex-col items-center lg:items-start">
      <h2 class="text-3xl font-bold headline-font tracking-tighter uppercase mb-6">Technical Stack</h2>
      <p class="mb-6 max-w-md" style="color: var(--color-on-surface-variant)">
        Built on enterprise-grade tools, with security gated into the pipeline rather than bolted on after.
      </p>
      <p class="mb-8 max-w-md" style="color: var(--color-on-surface-variant)">
        Supporting customers to overcome deployment issues and significantly remove technical debt.
      </p>

      <div class="space-y-4 inline-block text-left w-full">
        {highlights.map(item => (
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 flex items-center justify-center self-center shrink-0" style={`background-color: ${item.tint}`}>
              <span
                class="material-symbols-outlined"
                style={`color: var(--color-${item.iconColor})`}
              >{item.icon}</span>
            </div>
            <div class="self-center">
              <div class="text-sm font-bold">{item.title}</div>
              <div class="text-xs font-mono" style="color: var(--color-on-surface-variant)">{item.detail}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="border p-6 code-font text-xs md:text-sm leading-relaxed overflow-x-auto terminal-glow mx-auto lg:mx-0 w-full max-w-lg" style="background-color: var(--color-surface-container-lowest); border-color: rgba(65, 71, 84, 0.3)">
      <div class="mb-4" style="color: var(--color-secondary); opacity: 0.5"># technical_capabilities.yaml</div>
      <div class="space-y-3">
        {resumeData.skills.map(group => (
          <div>
            <span class="text-primary">{group.key}:</span>
            <div class="pl-4" style="color: var(--color-on-surface-variant)">
              <span class="text-secondary">[</span>{group.items.join(", ")}<span class="text-secondary">]</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
